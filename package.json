{
  "name": "ancestralpath",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "prebuild": "node scripts/sync-routes.mjs",
    "build": "vite build && node scripts/prepare-github-pages.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "npm run build && node tests/smoke.mjs",
    "test:routes": "node tests/smoke.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "generate:load-fixture": "node scripts/generate-load-fixture.mjs"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
